{
    "name": "pushstream/pushstream-php",
    "description": "PushStream PHP SDK for real-time messaging",
    "type": "library",
    "keywords": ["websocket", "realtime", "pusher", "messaging", "laravel"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ceylon IT Solutions",
            "email": "support@ceylonitsolutions.online"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "PushStream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PushStream\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PushStream\\Laravel\\PushStreamServiceProvider"
            ],
            "aliases": {
                "PushStream": "PushStream\\Laravel\\PushStreamFacade"
            }
        }
    },
    "minimum-stability": "stable"
}
